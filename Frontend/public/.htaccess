<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/v1/* requests through the same-origin PHP proxy
  RewriteRule ^api/v1/(.*)$ api-proxy.php?__path=/$1 [QSA,L]

  # Allow existing files and directories (assets, api-proxy.php, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>
